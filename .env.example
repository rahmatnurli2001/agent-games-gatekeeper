# Proof Gatekeeper — copy to .env and fill in (never commit .env)
# PORT is set by the host (Railway/Render set it automatically); 8080 is the local default.
PORT=8080
# From the Agent Games dashboard: Control Room -> your agent -> "Rotate Secret".
# The platform shows the plaintext exactly ONCE. Paste it here, restart.
# Without it, inbound HMAC verification is DISABLED (health shows it) and
# preflight will fail with a signature error.
AGENT_GAMES_HMAC_SECRET=
# HMAC header format. Default "hex" (lowercase hex HMAC-SHA256 of the raw body).
# If the platform rejects preflight, try "sha256=" (the "sha256=<hex>" form).
AGENT_GAMES_HMAC_FORMAT=hex
# How the envelope task_id string maps to a circuit field element.
# Default "keccak" (keccak256(task_id) mod field prime). Alternatives: "numeric", "hex".
# OPEN — confirm against a practice task; switch if the platform rejects the proof.
GATEKEEPER_TASK_ID_MODE=keccak
